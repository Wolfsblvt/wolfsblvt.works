---
/**
 * The document every page shares: identity metadata, dark-only declaration, self-hosted fonts, the Walk behind the
 * content, header, footer and the site-wide behaviour. Page titles follow `<Page> · Wolfsblvt Works`; the home page is
 * `Wolfsblvt Works` alone.
 */
import site from '../../site.config.mjs';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Walk from '../components/Walk.astro';
import { markMotionCss } from '../lib/marks';
import '../styles/fonts.generated.css';
import '../styles/base.css';
import '../styles/header.css';
import '../styles/footer.css';

interface Props {
  /** The page's own name; omit on the home page. */
  page?: string;
  description: string;
  /** Absolute canonical URL; omitted on error pages, which are not a place to point search engines at. */
  canonical?: string;
  /** `index` for ordinary pages, `legal` for Impressum and Privacy (noindex, nosnippet), `noindex` for errors. */
  indexing?: 'index' | 'legal' | 'noindex';
  /** Absolute URL of the page's social card; legal and error pages have none. */
  socialImage?: { url: string; alt: string };
  home?: boolean;
  navOn?: string;
  loc?: string;
  linkOrigin?: string;
  walk?: { intensity?: 'quiet' | 'standard' | 'bold'; frayEnds?: boolean };
  footerCurrent?: 'contact' | 'privacy' | 'impressum';
  structuredData?: Record<string, unknown>;
}

const {
  page,
  description,
  canonical,
  indexing = 'index',
  socialImage,
  home = false,
  navOn,
  loc,
  linkOrigin = '',
  walk = {},
  footerCurrent,
  structuredData,
} = Astro.props;

const title = page ? `${page} · ${site.title}` : site.title;
const socialTitle = page ?? site.title;
const robots = indexing === 'legal' ? 'noindex, nosnippet' : indexing === 'noindex' ? 'noindex' : null;
const shareable = indexing === 'index';
const jsonLd = structuredData ? JSON.stringify(structuredData).replaceAll('<', '\\u003c') : null;
const motionCss = markMotionCss();
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="darkreader-lock" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content={site.themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="preload" href="/fonts/literata-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/albert-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    {shareable && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={site.title} />
        <meta property="og:title" content={socialTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:locale" content={site.locale} />
        {socialImage && <meta property="og:image" content={socialImage.url} />}
        {socialImage && <meta property="og:image:width" content="1200" />}
        {socialImage && <meta property="og:image:height" content="630" />}
        {socialImage && <meta property="og:image:alt" content={socialImage.alt} />}
        <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
        <meta name="twitter:title" content={socialTitle} />
        <meta name="twitter:description" content={description} />
        {socialImage && <meta name="twitter:image" content={socialImage.url} />}
        {socialImage && <meta name="twitter:image:alt" content={socialImage.alt} />}
      </>
    )}
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
    <style is:global set:html={motionCss}></style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="root" data-root>
      <Walk intensity={walk.intensity ?? (home ? 'standard' : 'quiet')} frayEnds={walk.frayEnds} />
      <div data-walk-content>
        <slot name="before-header" />
        <Header home={home} navOn={navOn} loc={loc} linkOrigin={linkOrigin} markStill={!home}>
          <slot name="loc" slot="loc" />
        </Header>
        <slot />
        <Footer home={home} linkOrigin={linkOrigin} current={footerCurrent} />
      </div>
    </div>
    <div class="toast" role="status" aria-live="polite" data-toast></div>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
