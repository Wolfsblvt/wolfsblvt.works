---
/**
 * Off the path: the address you tried, struck through with a handwritten correction; the Walk lines lose each other
 * below the copy; Yoru gets lost here too. Served for every missing route; not indexed.
 */
import site from '../../site.config.mjs';
import Base from '../layouts/Base.astro';
import '../styles/rooms.css';
---

<Base
  page="Off the path"
  description="This address doesn’t lead anywhere on wolfsblvt.works."
  indexing="noindex"
  walk={{ intensity: 'quiet', frayEnds: true }}
>
  <main id="main" class="frame lift er">
    <div>
      <p class="kicker er-code">404 · not found</p>
      <h1 class="er-h">Off the path.</h1>
      <p class="er-path">
        <span class="er-url"><span class="sr">The address you tried: </span><span data-missing-path>/a-place-that-isn’t-here</span><svg class="strike" aria-hidden="true" viewBox="0 0 400 40" preserveAspectRatio="none"><path d="M4 22 C 80 12, 160 30, 240 17 S 360 15, 396 21"></path></svg></span>
        <span class="er-ins" aria-hidden="true">not here. moved, maybe? or never was.</span>
      </p>
      <p class="er-lead">Maybe it moved, maybe it never existed, maybe it’s still an idea somewhere on the pile.</p>
      <div class="er-acts">
        <a class="btn btn-solid" href="/">Back to the start</a>
        <a class="btn btn-line" href="/#whoa">Look at today’s pile</a>
        <a class="er-quiet" href={site.contactUrl}>Tell me what should have been here →</a>
      </div>
    </div>
    <div class="er-yoru">
      <div class="er-cap" aria-hidden="true" data-yoru-lost-cap><span>Yoru gets lost here too.</span><svg width="30" height="26" viewBox="0 0 30 26" fill="none" stroke="#ef8ea1" stroke-width="1.6" stroke-linecap="round"><path d="M3 5c8 1 15 6 22 16"></path><path d="M18 20l7 1.5-1-7"></path></svg></div>
      <button class="yoru-btn" type="button" aria-label="Yoru, the resident. Click him and he runs off." title="Yoru" data-yoru-lost><div class="sprite s-idle"></div></button>
      <div class="er-ground"></div>
    </div>
  </main>
  <script is:inline>
    // Show the address that was actually tried. Text only; never interpreted as markup.
    (function () {
      var el = document.querySelector('[data-missing-path]');
      if (!el || location.pathname === '/404/' || location.pathname === '/404.html') return;
      var tried = location.pathname + location.search;
      try { tried = decodeURI(tried); } catch (e) {}
      el.textContent = tried;
    })();
  </script>
  <script>
    import '../scripts/room';
  </script>
</Base>
