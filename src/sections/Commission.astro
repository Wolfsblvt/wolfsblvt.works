---
import site from '../../site.config.mjs';
import Icon from '../components/Icon.astro';

const enquiry = new URL(site.contactUrl);
enquiry.searchParams.set('category', 'consulting');
---

<section id="work-with-me" class="frame sec lift commission" aria-labelledby="commission-title">
  <div class="commission-copy">
    <h2 id="commission-title">Have a difficult bit of your own?</h2>
    <p>I also take paid commissions: a thorough audit, an honest technical second opinion, or a focused rescue.</p>
    <p>Agent setups and autonomous teams intended to work around the clock. Workflows that need too much babysitting. C#/.NET and JavaScript projects
      that have outgrown their first good idea. Understanding what’s going wrong is very much my thing.</p>
    <p class="commission-details">One-off reports or ongoing work, with scope and fees agreed individually.
      Human-only analysis and writing available on request. English and German enquiries are welcome.</p>
    <div class="commission-actions">
      <a class="btn btn-solid" href={site.links.consulting}>See what you can commission <Icon ui="lucide:arrow-up-right" /></a>
      <a class="lk" href={enquiry.href}>Ask about paid work</a>
    </div>
  </div>
  <p class="commission-aside">yes, you can hire<br />the person behind the pile.</p>
</section>

<style>
  .commission { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 48px; align-items: center; }
  .commission-copy { max-width: 66ch; padding-block: 38px; border-block: 1px solid rgb(243 232 220 / 14%); }
  h2 { margin: 0 0 24px; font: 350 clamp(32px, 3.7vw, 52px)/1.13 var(--serif); letter-spacing: -.025em; text-wrap: balance; }
  .commission-copy p { margin: 0 0 16px; color: var(--text-soft); font-size: clamp(17px, 1.5vw, 20px); line-height: 1.65; }
  .commission-copy .commission-details { font: 15px/1.6 var(--sans); color: var(--text-quiet); margin-top: 24px; }
  .commission-actions { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: center; margin-top: 28px; }
  .commission-aside { margin: 0; max-width: 16ch; font: 500 23px/1.45 var(--hand); color: var(--rose); transform: rotate(-4deg); }
  @media (max-width: 820px) {
    .commission { grid-template-columns: 1fr; gap: 18px; }
    .commission-aside { justify-self: end; margin-right: 18px; font-size: 20px; }
  }
</style>
