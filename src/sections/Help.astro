---
/**
 * Help: the original of the shared Works sponsor section, lifted from the marks return. It plays its motion once,
 * the first time it is properly in view (home.ts); otherwise it shows its finished state.
 */
import site from '../../site.config.mjs';
import { sponsorCss, sponsorSection } from '../lib/marks';

const html = sponsorSection(site.sponsors);
const css = sponsorCss();
---

<section id="help" class="frame sec lift" aria-labelledby="sp-works-title">
  <Fragment set:html={html} />
</section>
<style is:global set:html={css}></style>
