---
/**
 * diffdevil's window: a strip, not a page. The project speaks in its own type, colour and words. The hook is its
 * counting idea (GitHub +3 / −2, diffdevil 3 Changed), the App is the meaningful expansion ("diffdevil, with a
 * memory.") with the product website's own Overview capture, and the Chrome extension a quieter one-line third note.
 */
import { Image } from 'astro:assets';
import site from '../../../site.config.mjs';
import lockupUrl from '../../../design/the-walk/assets/diffdevil-lockup-dark.svg?url';
import overview from '../../../design/the-walk/assets/diffdevil/app-overview.png';
import Anchor from '../../components/Anchor.astro';
import Icon from '../../components/Icon.astro';
import './diffdevil.css';
---

<div id="diffdevil" class="dd" data-reveal="dd">
  <div class="frame dd-grid">
    <Anchor id="diffdevil" name="diffdevil" />
    <div>
      <div class="dd-origin">I wanted a size label that counted changed lines as changed lines.</div>
      <h2 id="dd-h" style="margin:0"><img class="dd-logo" src={lockupUrl} alt="diffdevil" width="240" height="72" /></h2>
      <p class="dd-tag">The devil is in the diff.</p>
      <p class="dd-sub">Measure changes. Match rules. Act on the result.</p>
      <p class="dd-body">Git gives you additions and deletions. diffdevil shows what changed, then puts those facts to work in your labels, checks, and workflows.</p>
      <a href={site.links.diffdevil} class="dd-btn">Explore diffdevil →</a>
    </div>
    <figure class="dd-compare">
      <div class="dd-git">
        <span class="dd-k">GitHub</span>
        <span class="dd-counts"><span class="a">+3</span> / <span class="d">−2</span></span>
      </div>
      <div class="dd-arrow" aria-hidden="true">→</div>
      <div class="dd-changed">
        <span class="dd-k">diffdevil</span>
        <span class="dd-n">3</span><span class="dd-w">Changed</span>
      </div>
      <figcaption>Two lines rewritten. One added.</figcaption>
    </figure>
  </div>

  <div class="frame dd-app">
    <div>
      <span class="dd-k">diffdevil GitHub App</span>
      <h3>diffdevil, with a memory.</h3>
      <p>See how pull requests move through your repositories: what changed, what merged, how big the work was, and how the story looks over time. Checks and labels are only the beginning.</p>
      <p class="dd-ext-line"><Icon product="diffdevil/changed" size={18} /><span><strong>See Changed directly inside GitHub.</strong> The Chrome extension, where you already review.</span></p>
      <a class="dd-ext-btn" href={`${site.links.diffdevil}/extension/`}><Icon ui="lucide:chrome" size={15} /> Add to Chrome</a>
    </div>
    <Image
      class="dd-shot"
      src={overview}
      alt="The diffdevil App Overview across seven repositories: merged pull requests in the last 30 days against the period before, opened and open work, time to merge, median Changed and raw churn, then the change-volume chart split into modified, added-only and deleted-only lines."
      widths={[640, 960, 1280]}
      sizes="(min-width: 900px) 52vw, 100vw"
      loading="lazy"
    />
  </div>
</div>
