---
/** Hi: the sentence with its correction, the invitation, and Yoru on his perch. */
import YoruStill from '../components/YoruStill.astro';
---

<section id="hi" class="frame hero lift" data-hero>
  <h1 class="hero-h">
    <span class="hero-a">Oddly useful</span>
    <span class="hero-b">
      <span class="strike-wrap"><del class="hero-del"><span class="sr">crossed out: </span>software.</del><svg class="strike" aria-hidden="true" viewBox="0 0 400 40" preserveAspectRatio="none"><path class="strike-ghost" d="M4 22 C 80 10, 160 30, 240 16 S 360 14, 396 20"></path><path class="strike-main" d="M4 22 C 80 10, 160 30, 240 16 S 360 14, 396 20"></path></svg></span><ins class="hero-ins"><span class="sr">corrected to: </span>things. also games. also questions.</ins>
    </span>
  </h1>
  <div class="hero-foot">
    <p class="hero-sub">I’m Wolf. Come see what we’re making.</p>
    <div class="perch">
      <div class="yoru-cap" aria-hidden="true" data-yoru-cap>
        <span>that’s Yoru. he lives here.</span>
        <svg width="44" height="36" viewBox="0 0 44 36"><path d="M3 30 C 18 31, 32 24, 38 6" fill="none" stroke="#ef8ea1" stroke-width="1.8" stroke-linecap="round"></path><path d="M31.5 11 L38 5 L41.5 13" fill="none" stroke="#ef8ea1" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </div>
      <div class="perch-spot">
        <div class="hero-yoru" data-yoru-hero>
          <YoruStill pose="idle" label="Yoru, the resident, standing on a line. He lives here." />
        </div>
      </div>
      <div class="perch-line" data-yoru-perch></div>
    </div>
  </div>
</section>