---
/** Stack binding only: Works owns markup, copy, artwork and motion in the bundle. */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { renderWorksSponsor } from '../lib/works-sponsor.mjs';
import '../../brand/bundle/works/css/works-sponsor.css';
interface Props { github?: string; kofi?: string; idPrefix?: string; heading?: number; context?: string }
const { github, kofi, idPrefix = 'sp-works', heading = 2, context = "Your support gives me more room for the projects that need a longer stretch of attention, and helps cover infrastructure, releases and artwork." } = Astro.props;
const template = readFileSync(join(process.cwd(), 'brand/bundle/works/components/works-sponsor.html'), 'utf8');
const html = renderWorksSponsor(template, { github, kofi, idPrefix, heading, context })
  .replace('class="works-sponsor"', 'class="works-sponsor host-works"');
---
<Fragment set:html={html} />
<script>
  import { mountWorksSponsors } from '../../brand/bundle/works/components/works-sponsor.mjs';
  mountWorksSponsors();
</script>
