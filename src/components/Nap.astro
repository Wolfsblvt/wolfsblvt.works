---
/**
 * Yoru, asleep on a line, with a handwritten note: the legal rooms' quiet resident. The still frame is for visitors
 * without JavaScript; src/scripts/room.ts lets him sleep there for real.
 */
import YoruStill from './YoruStill.astro';
interface Props {
  lines: string[];
}
const { lines } = Astro.props;
---

<div class="lg-nap" data-yoru-nap>
  <div class="lg-nap-cap" aria-hidden="true">
    <span>{lines.map((line, i) => <>{i > 0 && <br />}{line}</>)}</span>
    <svg width="34" height="30" viewBox="0 0 34 30" fill="none" stroke="#ef8ea1" stroke-width="1.6" stroke-linecap="round"><path d="M3 6c9 1 18 6 26 17"></path><path d="M22 22l7 1.5-1-7"></path></svg>
  </div>
  <YoruStill pose="asleep" label="Yoru, asleep." />
  <div class="lg-nap-line" data-yoru-nap-ground></div>
</div>
