---
/**
 * One Endless window. The article owns the canonical `pile-<id>` address, its path-side permalink marker and the
 * single title heading; the form decides the composition. Sub-line, paragraphs (the entry's body), Wolf's scribble,
 * standing and links are available to every form and never compulsory.
 */
import { render } from 'astro:content';
import type { PileEntry } from '../catalogue';
import { markBackground } from '../catalogue';
import { NOTE_TAPES } from '../notes';
import { mulberry32, hashString } from '../../../lib/shape';

interface Props {
  entry: PileEntry;
  index: number;
}
const { entry, index } = Astro.props;
const { title, form, subline, scribble, standing, links, illustrative } = entry.data;
const { Content } = await render(entry);
const hid = `h-pile-${entry.id}`;
const strip = form.kind === 'chip' && !!form.strip;
const tapes = form.kind === 'note' ? NOTE_TAPES[form.preset] : null;
const grid = (() => {
  const rnd = mulberry32(hashString(`grid|${entry.id}`));
  return Array.from({ length: 24 }, () => (rnd() < 0.55 ? 'rgb(115 202 227 / 55%)' : 'rgb(243 232 220 / 8%)'));
})();
const urlLinks = links.filter((link): link is Extract<typeof link, { href: string }> => 'href' in link);
const stubLink = form.kind === 'site' ? urlLinks.find((link) => link.id === form.destination) : undefined;
const listedLinks = links.filter((link) => link !== stubLink);
const showLinks = listedLinks.length > 0 && form.kind !== 'artifact';
const hasBody = entry.body !== undefined && entry.body.trim().length > 0;
---

<article id={`pile-${entry.id}`} class:list={['e-item', `e-w-${strip ? 'strip' : form.kind}`, `e-a-${index % 3}`]} aria-labelledby={hid} data-entry={entry.id}>
  <a class="perma" href={`#pile-${entry.id}`} aria-label={`Link to ${title}`} title={`Link to ${title}`} data-pile-link={entry.id}>#</a>

  {form.kind === 'thought' && <h3 id={hid} class="e-h e-stmt">{title}</h3>}

  {form.kind === 'note' && tapes && (
    <div class={`paper-wrap v-${form.preset}`} style="max-width:560px;transform:rotate(-1deg)">
      <span class="tape" style={`top:0;${tapes[0]}`} aria-hidden="true"></span>
      {tapes[1] && <span class="tape b" style={`top:0;${tapes[1]}`} aria-hidden="true"></span>}
      <div class={`paper ${form.lettering === 'typed' ? 'typed' : 'hand'}`} style="font-size:clamp(22px,2.2vw,30px);padding:34px 32px 38px">
        <h3 id={hid} class="e-h" style="font:inherit">{title}</h3>
        {scribble && <div style="margin-top:14px;font:500 16px var(--hand);color:#a0405e;transform:rotate(-2deg)">{scribble}</div>}
      </div>
    </div>
  )}

  {form.kind === 'chip' && !strip && (
    <div class="chipgrid">
      <div style="display:flex;gap:22px;align-items:flex-start">
        <span class="pa-icon" style={`width:96px;height:96px;border-radius:26px;font-size:40px;flex:none;background:${markBackground(form.mark.tint)}`}>{form.mark.letter}</span>
        <div>
          <div class="kicker">{form.platform}</div>
          <h3 id={hid} class="e-h ui" style="font-weight:800;font-size:clamp(28px,3vw,42px);line-height:1;letter-spacing:-.03em;margin-top:8px">{title}</h3>
        </div>
      </div>
      <div class="fixture" role="img" aria-label="Illustrative fixture of the extension">
        <span class="ill tag">illustrative fixture</span>
        <div style="font-weight:700;font-size:13px">{title}</div>
        <div style="display:grid;grid-template-columns:repeat(8,1fr);gap:5px;margin-top:12px">{grid.map((g) => <span style={`height:22px;border-radius:4px;background:${g}`}></span>)}</div>
      </div>
    </div>
  )}

  {form.kind === 'chip' && strip && (
    <div style={`padding:44px clamp(24px,4vw,56px);border-radius:4px;background:${form.strip};font-family:var(--sans)`}>
      <div style="font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:rgb(251 243 234 / 72%)">{form.platform}</div>
      <h3 id={hid} class="e-h" style="font-weight:800;font-size:clamp(36px,5vw,68px);line-height:.95;letter-spacing:-.035em;margin-top:12px;color:#fbf3ea">{title}</h3>
    </div>
  )}

  {form.kind === 'artifact' && (
    <div class="e-term">
      <div style="display:flex;justify-content:space-between;gap:12px;padding:12px 20px;border-bottom:1px solid rgb(115 202 227 / 14%);font:600 14px var(--sans);color:#9cc9d9">
        <h3 id={hid} class="e-h" style="font:inherit">{title}</h3><span style="font-weight:400;color:#8fa3b0">{form.caption}</span>
      </div>
      <pre>{form.example ?? form.excerpt}</pre>
      {listedLinks.length > 0 && (
        <div class="e-term-links">
          {listedLinks.map((link) => 'href' in link
            ? <a href={link.href}>{link.label} ↗</a>
            : <a href={`#pile-${link.entry.id}`} data-pile-link={link.entry.id}>{link.label} →</a>)}
        </div>
      )}
    </div>
  )}

  {form.kind === 'lineage' && (
    <div class="e-lin">
      <div class="e-node" style="border:1.5px dashed rgb(243 232 220 / 35%);color:var(--text-soft);font-size:15px">{form.from}<span style="display:block;font-size:12px;color:var(--text-faint);margin-top:4px">the original, with its credit</span></div>
      <div style="display:flex;flex-direction:column;align-items:center;gap:2px">
        <span class="scribble" style="font-size:14px">{form.relationship}</span>
        <svg width="72" height="16" viewBox="0 0 72 16" aria-hidden="true"><path d="M2 8h62" stroke="#ef8ea1" stroke-width="1.6" stroke-dasharray="4 4"></path><path d="m60 3 6 5-6 5" fill="none" stroke="#ef8ea1" stroke-width="1.6"></path></svg>
      </div>
      <div class="e-node" style="background:var(--rose);color:var(--canvas);border:3px solid var(--text);transform:rotate(1.5deg)"><h3 id={hid} class="e-h" style="font:800 17px var(--sans)">{title}</h3></div>
    </div>
  )}

  {form.kind === 'door' && (
    <div class="e-door">
      <div class="pd-arch"><span class="pd-name" style="font-size:14px">{title}</span></div>
      <div><h3 id={hid} class="sr">{title}</h3><p class="ui" style="margin:0;font-size:16px;color:var(--text-faint);max-width:30ch">{form.caption}</p></div>
    </div>
  )}

  {form.kind === 'specimen' && (
    <div style="display:flex;gap:30px;align-items:center;flex-wrap:wrap" data-interaction={entry.id}>
      <button class="die" type="button" style="width:120px;height:120px;font-size:54px;border-radius:26px;flex:none" aria-label={`Roll the die. Current value ${form.face}`} data-die disabled>{form.face}</button>
      <div><h3 id={hid} class="e-h scribble" style="font-size:clamp(28px,3vw,40px)">{title}</h3></div>
    </div>
  )}

  {form.kind === 'site' && stubLink && (
    <div class="tk" style={`background:${form.background};border:1px solid ${form.mark.tint}55;max-width:660px;border-radius:12px`}>
      <div class="tk-main" style="padding:24px 26px">
        <div style="display:flex;align-items:center;gap:10px">
          <span class="tk-fav" style={`width:24px;height:24px;font-size:12px;background:${form.mark.tint}`}>{form.mark.letter}</span>
          <span class="tk-dom" style={`font-size:14px;color:${form.mark.tint}`}>{form.domain}</span>
        </div>
        <h3 id={hid} class="e-h ui" style="font-weight:800;font-size:32px;letter-spacing:-.02em;margin-top:10px">{title}</h3>
      </div>
      <a class="tk-stub" style={`color:${form.mark.tint};border-left:1.5px dashed ${form.mark.tint}88;width:96px;font-size:26px`} href={stubLink.href} aria-label={`Visit ${title}`} data-tear>↗</a>
    </div>
  )}

  {subline && <p class="e-sub">{subline}</p>}
  {hasBody && <div class="e-body"><Content /></div>}
  {scribble && form.kind !== 'note' && <div class="e-scr">{scribble}</div>}
  {standing && <p class="e-std">{standing}</p>}
  {showLinks && (
    <div class="e-links">
      {listedLinks.map((link) => 'href' in link
        ? <a class="lk" href={link.href}>{link.label}<span aria-hidden="true"> ↗</span></a>
        : <a class="lk" href={`#pile-${link.entry.id}`} data-pile-link={link.entry.id}>{link.label}<span aria-hidden="true"> →</span></a>)}
    </div>
  )}
  {illustrative && <p class="ill" style="margin-top:12px">illustrative entry</p>}
</article>
