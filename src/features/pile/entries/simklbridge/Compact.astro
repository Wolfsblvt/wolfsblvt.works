---
/** SimklBridge, compact: the taped request note, with the name beneath it. */
import type { PileEntry } from '../../catalogue';
import Note from './Note.astro';

interface Props {
  entry: PileEntry;
}
const { entry } = Astro.props;
const { title } = entry.data;
---

<div class="sb">
  <Note />
  <span class="sb-name">{title}</span>
</div>

<style>
  .sb { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 8px 12px 2px; font-family: var(--sans); }
  .sb-name { font-weight: 600; font-size: 14px; line-height: 1.2; text-shadow: 0 0 8px #100b11; }
</style>
