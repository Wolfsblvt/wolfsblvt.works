---
/**
 * SimklBridge, alternative expanded (the interactive set's poster chip, opened). Not registered: files under alt/
 * are not discovered by the Pile; a comparison page imports this directly. Same props as a regular expanded scene,
 * and the copy block arrives through the default slot in the same way. The words left; right, three posters with
 * depth, the two lines of the conversation and the breadth of the subject (Films / Series / Anime). Readable at rest,
 * no field, no second control.
 */
import type { PileEntry } from '../../../catalogue';

interface Props {
  entry: PileEntry;
  hid: string;
}
const { entry, hid } = Astro.props;
const { title } = entry.data;
---

<div class="wx">
  <div class="wx-words">
    <h3 id={hid} class="e-h wx-h">{title}</h3>
    <slot />
  </div>
  <div class="wx-scene">
    <div class="wx-posters" role="img" aria-label="Three miniature posters: a warm sunset, a mountain at dusk, and an unfamiliar pink moon."><span></span><span></span><span></span></div>
    <div class="wx-talk"><p class="wx-ask">Something strange, but not bleak.</p><p class="wx-answer">More atmosphere.<br />Less homework.</p></div>
    <p class="wx-types">Films / Series / Anime</p>
  </div>
</div>

<style>
  .wx { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr); gap: 50px; align-items: center; max-width: 920px; min-height: 480px; padding: 56px 42px; border: 1px solid #48344e; border-radius: 16px; background: #211a2a; font-family: var(--sans); }
  .wx-words { min-width: 0; }
  .wx-h { font: 500 clamp(26px, 2.8vw, 34px)/1.15 var(--serif); letter-spacing: -.01em; }
  .wx-scene { position: relative; min-height: 330px; }
  .wx-posters { display: flex; align-items: center; justify-content: center; gap: 15px; padding: 12px 20px 0; }
  .wx-posters span { position: relative; box-sizing: border-box; width: 110px; height: 162px; border: 5px solid #392f3b; border-radius: 3px; box-shadow: 0 12px 18px rgb(0 0 0 / 30%); transform: rotate(-8deg); background: radial-gradient(circle at 50% 30%, #eeb77f 0 17%, transparent 17.5%), linear-gradient(145deg, transparent 40%, #714c53 40.5% 55%, #362d3c 55.5%), #a96d6d; }
  .wx-posters span:nth-child(2) { transform: translateY(-12px) rotate(3deg); background: radial-gradient(circle at 64% 21%, #d3d9af 0 13%, transparent 13.5%), linear-gradient(35deg, #183c4a 40%, #376265 40.5% 50%, transparent 50.5%), linear-gradient(#638c88, #aab295); }
  .wx-posters span:nth-child(3) { transform: rotate(9deg); background: radial-gradient(ellipse at 50% 34%, #e3a4c1 0 16%, #ac729e 16.5% 24%, transparent 24.5%), linear-gradient(130deg, #55416f, #241f41); }
  .wx-talk { position: relative; margin: 16px 7px 0; }
  .wx-ask, .wx-answer { box-sizing: border-box; max-width: 290px; margin: 0 0 10px; padding: 13px 17px; border-radius: 13px; font-size: 13px; line-height: 1.5; background: #49344e; color: #f0daeb; box-shadow: 0 8px 18px rgb(0 0 0 / 13%); }
  .wx-ask { margin-left: auto; border-bottom-right-radius: 3px; transform: rotate(1deg); }
  .wx-answer { border: 1px solid #6c5273; border-bottom-left-radius: 3px; background: #31273c; transform: rotate(-1deg); }
  .wx-types { margin: 20px 0 0; text-align: center; font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: #bf9dc3; }
  @media (max-width: 720px) {
    .wx { grid-template-columns: 1fr; gap: 12px; min-height: 0; padding: 30px 24px 25px; }
    .wx-posters { gap: 7px; padding: 12px 0 0; }
    .wx-posters span { width: 85px; height: 132px; }
    .wx-talk { margin-top: 20px; }
    .wx-ask, .wx-answer { max-width: 240px; font-size: 12px; }
  }
</style>
