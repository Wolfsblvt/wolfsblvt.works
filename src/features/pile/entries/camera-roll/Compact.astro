---
/**
 * Straight to the camera roll, compact: two overlapping paper photos, the front one with the moonlit scene peeking
 * out and the small aside "keep the good bit." written on its border.
 */
import type { PileEntry } from '../../catalogue';

/** The frame names the entry on its link; the stack itself shows only the photos and their aside. */
interface Props {
  entry: PileEntry;
}
---

<div class="stack">
  <span class="photo back" aria-hidden="true"></span>
  <span class="photo front">
    <span class="scene" aria-hidden="true"></span>
    <small>keep the good bit.</small>
  </span>
</div>

<style>
  .stack { position: relative; min-height: 195px; padding: 20px 16px 6px; font-family: var(--sans); }
  .photo { display: block; position: relative; box-sizing: border-box; padding: 9px 9px 32px; background: #eadcc6; box-shadow: 4px 10px 18px rgb(0 0 0 / 40%); }
  .photo.back { position: absolute; left: 40px; top: 16px; width: 180px; max-width: calc(100% - 56px); height: 150px; background: #d9c8b2; transform: rotate(-9deg); }
  .photo.front { width: 220px; max-width: calc(100% - 30px); margin-left: 30px; transform: rotate(6deg); }
  .photo small { position: absolute; left: 12px; bottom: 7px; font: italic 13px var(--serif); color: #553e42; }
  .scene { display: block; position: relative; height: 114px; overflow: hidden; background: linear-gradient(155deg, #30374e, #66526a 55%, #b48372); }
  .scene::before { content: ''; position: absolute; right: 23%; top: 20%; width: 34px; height: 34px; border-radius: 50%; background: #f5e5b7; box-shadow: 0 0 45px rgb(247 211 138 / 40%); }
  .scene::after { content: ''; position: absolute; inset: 65% -5% -10%; background: #252635; clip-path: polygon(0 33%, 20% 14%, 35% 43%, 62% 0, 90% 30%, 100% 20%, 100% 100%, 0 100%); }
</style>
