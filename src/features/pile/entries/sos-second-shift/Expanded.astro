---
/**
 * sOS Second Shift, expanded: the machine with a display, three workload rows and PLAY / WORK / SLEEP lamps. Play,
 * Work and Sleep buttons (revealed by interaction.ts) change all of them together with the caption; without the
 * script the Work scene stands complete.
 */
import type { PileEntry } from '../../catalogue';

interface Props {
  entry: PileEntry;
  hid: string;
}
const { entry, hid } = Astro.props;
---

<div class="ss">
  <h3 id={hid} class="e-h ss-h">{entry.data.title}</h3>
  <div class="e-side ss-side">
    <div class="e-side-scene">
      <div class="ss-stage" data-interaction={entry.id}>
        <div class="controls" role="group" aria-label="Machine postures" data-enhancement hidden>
          <button type="button" aria-pressed="false" data-shift="play">Play</button>
          <button type="button" aria-pressed="true" data-shift="work">Work</button>
          <button type="button" aria-pressed="false" data-shift="sleep">Sleep</button>
        </div>
        <div class="machine" data-machine-mode="work">
          <div class="case">
            <div class="case-top"><span>sOS / SECOND SHIFT</span><span class="power" aria-hidden="true"></span></div>
            <div class="display">
              <span class="display-mode" data-machine-label>WORK</span>
              <strong class="display-title" data-machine-title>The house has a few jobs.</strong>
              <span class="display-detail" data-machine-detail>Useful services. Background jobs. The box you already own.</span>
            </div>
            <div class="jobs">
              <div><span>Home services</span><b data-service-posture>Available</b></div>
              <div><span>Background jobs</span><b data-jobs-posture>Making progress</b></div>
              <div><span>Gaming</span><b data-gaming-posture>Ready when you are</b></div>
            </div>
            <div class="foot">
              <div class="vents" aria-hidden="true"></div>
              <div class="lamps"><span data-lamp="play">PLAY</span><span data-lamp="work" class="lit">WORK</span><span data-lamp="sleep">SLEEP</span></div>
            </div>
          </div>
          <p class="caption" aria-live="polite" aria-atomic="true" data-machine-caption>Useful work, on the machine you already own.</p>
        </div>
      </div>
    </div>
    <div class="e-side-copy"><slot /></div>
  </div>
</div>

<style>
  .ss { font-family: var(--sans); }
  .ss-h { font: 500 clamp(26px, 2.8vw, 34px)/1.15 var(--serif); letter-spacing: -.01em; }

  .ss-side { margin-top: 22px; }
  .controls { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 28px; }
  .controls[hidden] { display: none; }
  .controls button { min-height: 44px; padding: 9px 15px; border: 1px solid #65545c; border-radius: 4px; background: transparent; font: 13px/1.4 var(--sans); color: #e8d9cb; cursor: pointer; }
  .controls button[aria-pressed="true"] { color: #19141a; background: #f0d7b7; border-color: #f0d7b7; }

  .machine { --machine-light: #edbc70; max-width: 630px; margin: 0; }
  .machine[data-machine-mode="play"] { --machine-light: #c29cf0; }
  .machine[data-machine-mode="sleep"] { --machine-light: #7ca9ba; }

  .case { padding: 22px 24px 21px; border: 1px solid #5d6771; border-radius: 10px 10px 6px 6px; background: linear-gradient(130deg, #31363c, #1a2026); box-shadow: 0 9px 0 #090c10, 0 20px 38px rgb(0 0 0 / 25%); }
  .case-top { display: flex; align-items: center; justify-content: space-between; gap: 15px; margin-bottom: 21px; font: 10px/1.5 var(--mono); letter-spacing: .13em; color: #c4c9ca; }
  .power { width: 8px; height: 8px; border-radius: 50%; background: var(--machine-light); box-shadow: 0 0 12px color-mix(in srgb, var(--machine-light) 40%, transparent); }
  .machine[data-machine-mode="sleep"] .power { background: #627985; box-shadow: none; }

  .display { min-height: 143px; padding: 19px 20px; border: 1px solid #495157; border-radius: 3px; background: #0e1418; }
  .machine[data-machine-mode="sleep"] .display { background: #10161a; border-color: #3d4d55; }
  .display-mode { display: block; font: 11px/1.4 var(--mono); letter-spacing: .16em; color: var(--machine-light); }
  .display-title { display: block; margin: 8px 0; font: 400 25px/1.2 var(--serif); color: #f1ece1; }
  .display-detail { display: block; font: 12px/1.5 var(--sans); color: #b9c5c9; }

  .jobs { padding: 17px 5px 19px; }
  .jobs div { display: flex; justify-content: space-between; gap: 15px; padding: 7px 0; font: 12px/1.5 var(--sans); }
  .jobs div + div { border-top: 1px solid rgb(67 75 81 / 30%); }
  .jobs span { color: #c6c6c4; }
  .jobs b { font-weight: 400; color: #e0d9c7; text-align: right; }

  .foot { display: flex; justify-content: space-between; align-items: center; gap: 25px; }
  .vents { flex-shrink: 1; width: 94px; height: 26px; background: repeating-linear-gradient(90deg, #0c1115 0 3px, transparent 3px 8px); }
  .lamps { display: flex; gap: 20px; font: 9px/1.4 var(--mono); color: #b6bcbf; }
  .lamps span::before { content: ''; display: block; width: 6px; height: 6px; margin: 0 auto 7px; border-radius: 50%; background: #5c646a; }
  .lamps .lit::before { background: var(--machine-light); box-shadow: 0 0 9px color-mix(in srgb, var(--machine-light) 40%, transparent); }

  .caption { margin: 24px auto 0; padding: 0 4px; font: italic 15px/1.5 var(--serif); text-align: center; color: #d0c2bc; }

  @media (max-width: 600px) {
    .controls { gap: 7px; }
    .controls button { padding: 9px 11px; font-size: 12px; }
    .case { padding: 20px 16px; }
    .display { min-height: 170px; padding: 16px; }
    .display-title { font-size: 23px; }
    .jobs div { gap: 10px; font-size: 11px; }
    .foot { gap: 14px; }
    .lamps { gap: 15px; }
    .vents { width: 55px; }
  }
</style>
