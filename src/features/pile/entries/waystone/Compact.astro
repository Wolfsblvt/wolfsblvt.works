---
/**
 * Waystone, compact: a small paper folio with a green spine and a metal clip. Its kicker, the name, the hook in two
 * lines and the three things it keeps.
 */
import type { PileEntry } from '../../catalogue';

interface Props {
  entry: PileEntry;
}
const { entry } = Astro.props;
const { title, subline = '' } = entry.data;
const lines = subline.split(/(?<=[.!?])\s+/);
---

<div class="ws">
  <div class="ws-folio">
    <span class="ws-kick">The way back</span>
    <b class="ws-name">{title}</b>
    <p class="ws-hook">{lines.map((line) => <span>{line}</span>)}</p>
    <span class="ws-lines">work / settings / saves</span>
  </div>
</div>

<style>
  .ws { padding: 14px 14px 12px 6px; }
  .ws-folio { position: relative; box-sizing: border-box; width: min(250px, 100%); min-height: 200px; padding: 20px 23px; background: #cbbd9b; color: #39342e; border-left: 14px solid #494e46; border-radius: 2px; transform: rotate(-4deg); box-shadow: 6px 6px 0 #867a64, 9px 9px 0 #3b3032; font-family: var(--sans); }
  .ws-folio::before { content: ''; position: absolute; top: -10px; left: 95px; width: 50px; height: 22px; box-sizing: border-box; background: #858275; border: 2px solid #b3b099; border-radius: 5px; }
  .ws-kick { font-size: 9px; letter-spacing: .13em; text-transform: uppercase; }
  .ws-name { display: block; margin: 15px 0 8px; font: 400 24px/1.1 var(--serif); }
  .ws-hook { margin: 0; font: 400 12px/1.5 var(--serif); }
  .ws-hook span { display: block; }
  .ws-lines { display: block; margin-top: 18px; padding-top: 8px; border-top: 1px solid #978b6c; font-size: 10px; word-spacing: 5px; }
</style>
