---
/**
 * Waystone, expanded: the recovery folio open beside the entry's words. THE WAY BACK, "Keep the parts that make it
 * yours", and what Work, Settings and Saves each hold. The folio is readable text, not a picture; it needs no
 * interaction. On wide screens it sits left of the words, on narrow ones below them.
 */
import type { PileEntry } from '../../catalogue';

interface Props {
  entry: PileEntry;
  hid: string;
}
const { entry, hid } = Astro.props;
const { title } = entry.data;
---

<div class="ws">
  <div class="ws-words">
    <h3 id={hid} class="e-h ws-h">{title}</h3>
    <slot />
  </div>
  <div class="ws-folio">
    <span class="ws-kick">The way back</span>
    <p class="ws-title">Keep the parts<br />that make it yours.</p>
    <dl class="ws-list">
      <div><dt>Work</dt><dd>The things you made.<br />The place you left off.</dd></div>
      <div><dt>Settings</dt><dd>The small decisions that make a machine feel familiar.</dd></div>
      <div><dt>Saves</dt><dd>Worlds, progress, and the next place you’ll return to.</dd></div>
    </dl>
    <p class="ws-foot">Know what matters.<br />Know the way back.</p>
  </div>
</div>

<style>
  .ws { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); align-items: center; max-width: 900px; padding: 16px 16px 20px 4px; }
  .ws-words { grid-column: 2; grid-row: 1; min-width: 0; }
  .ws-h { font: 500 clamp(26px, 2.8vw, 34px)/1.15 var(--serif); letter-spacing: -.01em; }
  .ws-folio { grid-column: 1; grid-row: 1; position: relative; box-sizing: border-box; padding: 37px 37px 36px 52px; background: #cfc4a6; color: #37362d; border-left: 18px solid #4d584c; border-radius: 3px; transform: rotate(-2deg); box-shadow: 8px 8px 0 #978c73, 12px 12px 0 #3b3732, 0 25px 45px rgb(0 0 0 / 30%); font-family: var(--sans); }
  .ws-folio::before { content: ''; position: absolute; top: -12px; left: calc(50% - 40px); width: 80px; height: 29px; box-sizing: border-box; border-radius: 5px; background: linear-gradient(#a6a592, #727a6a); border: 2px solid #bdbaa6; }
  .ws-kick { font-size: 9px; letter-spacing: .17em; text-transform: uppercase; }
  .ws-title { margin: 16px 0 28px; font: 400 clamp(26px, 3vw, 34px)/1.1 var(--serif); letter-spacing: -.03em; }
  .ws-list { margin: 0; }
  .ws-list div { display: grid; grid-template-columns: 70px minmax(0, 1fr); gap: 15px; padding: 15px 0; border-top: 1px solid #a89f84; }
  .ws-list dt { font: 400 17px/1.3 var(--serif); }
  .ws-list dd { margin: 0; font-size: 12px; line-height: 1.5; }
  .ws-foot { margin: 15px 0 0; font: italic 400 18px/1.35 var(--serif); max-width: 24ch; }
  @media (max-width: 760px) {
    .ws { grid-template-columns: 1fr; gap: 36px; padding: 8px 18px 22px 6px; }
    .ws-words, .ws-folio { grid-column: auto; grid-row: auto; }
    .ws-folio { padding: 30px 24px 28px 28px; }
  }
</style>
