---
/**
 * Shikkuri, alternative compact (the interactive set's game-sleeve specimen). Not registered: files under alt/ are
 * not discovered by the Pile; a comparison page imports this directly. Same props as a regular compact scene.
 * A late-evening card with two game sleeves, the hook across the top and the name in the corner.
 */
import type { PileEntry } from '../../../catalogue';

interface Props {
  entry: PileEntry;
}
const { entry } = Astro.props;
const { title } = entry.data;
---

<div class="gm">
  <div class="gm-card">
    <span class="gm-hook">A game that fits tonight.</span>
    <span class="gm-sleeve gm-behind" aria-hidden="true"></span>
    <span class="gm-sleeve gm-front" aria-hidden="true"></span>
    <span class="gm-title">{title}</span>
  </div>
</div>

<style>
  .gm { padding: 8px 10px 10px; }
  .gm-card { position: relative; box-sizing: border-box; width: 100%; height: 240px; padding: 24px; overflow: hidden; border: 1px solid #4b6258; border-radius: 8px; background: linear-gradient(135deg, #263d3b, #142128); transform: rotate(2deg); font-family: var(--sans); }
  .gm-hook { position: absolute; left: 20px; top: 19px; z-index: 3; max-width: 140px; font-size: 10px; letter-spacing: .05em; color: #d0ded2; }
  .gm-title { position: absolute; left: 20px; bottom: 20px; z-index: 3; font: 400 21px/1.1 var(--serif); }
  .gm-sleeve { position: absolute; right: 24px; top: 26px; box-sizing: border-box; width: 122px; height: 174px; border: 6px solid #cfdbbf; border-bottom-width: 27px; box-shadow: 0 15px 25px rgb(0 0 0 / 40%); transform: rotate(10deg); background: radial-gradient(circle at 67% 25%, #f3daa4 0 9%, transparent 10%), linear-gradient(158deg, transparent 52%, #254f44 53% 71%, #142e30 72%), linear-gradient(#607c70, #b0b9a1); }
  .gm-sleeve::after { content: 'somewhere quiet'; position: absolute; left: 0; right: 0; bottom: -22px; font-size: 8px; text-align: center; white-space: nowrap; color: #283c35; }
  .gm-behind { right: 83px; top: 23px; border-color: #9f9bab; transform: rotate(-9deg); background: radial-gradient(circle at 36% 30%, #eaa399 0 12%, transparent 13%), linear-gradient(33deg, #2c263e 44%, #645168 45%, #a192a5); }
  .gm-behind::after { content: 'a little mystery'; }
</style>
