---
/**
 * NO REPLY YET, expanded: the slip opens into a navy instrument face with cyan markings. The source premise is the
 * focal point, "Sent / Time between / Arrival" gives the delay a physical span, and a warm, slightly crooked paper
 * note gives the intervening life its dignity. Complete without a control; the copy follows.
 */
import type { PileEntry } from '../../catalogue';

interface Props {
  entry: PileEntry;
  hid: string;
}
const { entry, hid } = Astro.props;
---

<div class="nr">
  <h3 id={hid} class="e-h nr-h">{entry.data.title}</h3>
  <div class="e-side nr-side">
    <div class="e-side-scene">
      <div class="nr-scene">
        <div class="nr-micro">Morrow Relay · Correspondence</div>
        <p class="nr-premise">She wanted the work.<br />And she liked that nobody could demand an immediate answer.</p>
        <div class="nr-route"><span>Sent</span><span>Time between</span><span>Arrival</span></div>
        <p class="nr-note">Some days are good without a message arriving.</p>
      </div>
    </div>
    <div class="e-side-copy"><slot /></div>
  </div>
</div>

<style>
  .nr { font-family: var(--sans); }
  .nr-h { font: 400 clamp(26px, 3vw, 34px)/1.1 'Special Elite', var(--mono); letter-spacing: -.01em; }
  .nr-side { margin-top: 18px; }
  .nr-scene { max-width: 640px; padding: 24px; border-radius: 2px; background: #0b1e26; border: 1px solid #44686c; color: #c6e3e2; }
  .nr-micro { font: 500 11px/1.5 var(--mono); letter-spacing: .12em; text-transform: uppercase; color: #81b1b4; }
  .nr-premise { margin: 27px 0 30px; max-width: 390px; font: 400 clamp(23px, 4vw, 36px)/1.3 var(--serif); text-wrap: pretty; }
  .nr-route { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; padding-top: 10px; border-top: 1px solid #548a8d; font: 12px/1.5 var(--mono); color: #89aaaa; }
  .nr-route span:nth-child(2) { text-align: center; color: #e4bb83; }
  .nr-route span:last-child { text-align: right; }
  .nr-note { margin: 30px 0 0 25%; padding: 13px 16px; background: #c5b28d; color: #343e3c; font: 15px/1.4 var(--serif); transform: rotate(-2deg); box-shadow: 0 4px 12px rgb(0 0 0 / 25%); }
  @media (max-width: 540px) {
    .nr-scene { padding: 19px; }
    .nr-note { margin-left: 8%; }
  }
</style>
