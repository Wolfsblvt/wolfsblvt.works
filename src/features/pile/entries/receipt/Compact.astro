---
/**
 * ThereWeGo, compact: the warm torn stream receipt, typed on paper. The name and its "/ for Twitch" tag sit above the
 * slip; the host tilts the piece.
 */
import type { PileEntry } from '../../catalogue';

interface Props {
  entry: PileEntry;
}
const { entry } = Astro.props;
---

<div class="rc">
  <span class="rc-name">{entry.data.title} <span class="rc-for">/ for Twitch</span></span>
  <div class="paper">
    <small>STREAM RECEIPT</small>
    <span class="paper-h">One more try.</span>
    <small>02h 18m</small>
    <span class="rule" aria-hidden="true"></span>
    <div class="row"><span>Moments kept</span><span>7</span></div>
    <div class="row"><span>Category detours</span><span>3</span></div>
    <div class="row"><span>!sneeze</span><span>4</span></div>
    <span class="rule" aria-hidden="true"></span>
    <small>TOTAL</small>
    <span class="total">one good evening</span>
  </div>
</div>

<style>
  .rc { width: min(100%, 300px); margin: 0 auto; font-family: var(--sans); color: var(--text); }
  .rc-name { display: block; margin: 0 0 11px; font-size: 14px; line-height: 1.4; }
  .rc-for { font-size: 11px; letter-spacing: .13em; text-transform: uppercase; color: var(--text-soft); }
  .paper {
    padding: 24px 20px 30px;
    background: #eddfc8;
    color: #2d2629;
    font: 12px/1.6 var(--mono);
    box-shadow: 2px 8px 26px rgb(0 0 0 / 33%);
    clip-path: polygon(0 0, 100% 0, 100% 97%, 96% 100%, 92% 97%, 88% 100%, 84% 97%, 80% 100%, 76% 97%, 72% 100%, 68% 97%, 64% 100%, 60% 97%, 56% 100%, 52% 97%, 48% 100%, 44% 97%, 40% 100%, 36% 97%, 32% 100%, 28% 97%, 24% 100%, 20% 97%, 16% 100%, 12% 97%, 8% 100%, 4% 97%, 0 100%);
  }
  .paper small { display: block; text-align: center; font: 11px/1.5 var(--mono); letter-spacing: .12em; }
  .paper-h { display: block; margin: 15px 0 7px; text-align: center; font: 400 23px/1.1 var(--serif); }
  .rule { display: block; margin: 18px 0 13px; border-top: 1px dashed #746965; }
  .row { display: flex; justify-content: space-between; gap: 12px; padding: 4px 0; }
  .total { display: block; margin: 7px 0 10px; text-align: center; font: 400 20px/1.3 var(--serif); }
</style>
