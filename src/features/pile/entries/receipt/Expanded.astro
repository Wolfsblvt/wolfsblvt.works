---
/**
 * ThereWeGo, expanded: the same receipt lying beside the evening it stands for, three moments on a thread under
 * "An evening worth keeping". The copy (hook, paragraphs, the quiet last line, standing) follows the scene.
 */
import type { PileEntry } from '../../catalogue';

interface Props {
  entry: PileEntry;
  hid: string;
}
const { entry, hid } = Astro.props;

const MOMENTS = [
  { time: '00:19', title: 'The plan changes.', detail: 'A category detour. Naturally.' },
  { time: '01:26', title: 'Absolutely the last try.', detail: 'A moment kept. Famous last words.' },
  { time: '02:04', title: 'There we go.', detail: 'A moment kept. It worked.' },
];
---

<div class="tw">
  <div class="tw-head">
    <h3 id={hid} class="e-h tw-h">{entry.data.title}</h3>
    <span class="kicker">/ for Twitch</span>
  </div>
  <div class="tw-scene">
    <div class="paper">
      <small>STREAM RECEIPT</small>
      <span class="paper-h">One more try.</span>
      <small>02h 18m</small>
      <span class="rule" aria-hidden="true"></span>
      <dl>
        <div><dt>Moments kept</dt><dd>7</dd></div>
        <div><dt>Category detours</dt><dd>3</dd></div>
        <div><dt>!sneeze</dt><dd>4</dd></div>
      </dl>
      <span class="rule" aria-hidden="true"></span>
      <small>TOTAL</small>
      <span class="total">one good evening</span>
    </div>
    <div class="thread">
      <span class="kicker">An evening worth keeping</span>
      <ol class="moments">
        {MOMENTS.map((moment) => (
          <li>
            <span class="m-time">{moment.time}</span>
            <strong class="m-title">{moment.title}</strong>
            <span class="m-detail">{moment.detail}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
  <div class="tw-copy"><slot /></div>
</div>

<style>
  .tw { max-width: 700px; font-family: var(--sans); }
  .tw-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; }
  .tw-h { font: 500 clamp(26px, 2.8vw, 34px)/1.15 var(--serif); letter-spacing: -.01em; }
  .tw-scene { display: grid; grid-template-columns: minmax(170px, .82fr) minmax(0, 1fr); align-items: center; gap: 42px; margin: 28px 7px 0; }

  .paper {
    width: 100%;
    max-width: 260px;
    margin: auto;
    padding: 28px 24px 35px;
    background: #eddfc8;
    color: #2d2629;
    font: 12px/1.6 var(--mono);
    box-shadow: 2px 8px 26px rgb(0 0 0 / 33%);
    transform: rotate(-2deg);
    clip-path: polygon(0 0, 100% 0, 100% 97%, 96% 100%, 92% 97%, 88% 100%, 84% 97%, 80% 100%, 76% 97%, 72% 100%, 68% 97%, 64% 100%, 60% 97%, 56% 100%, 52% 97%, 48% 100%, 44% 97%, 40% 100%, 36% 97%, 32% 100%, 28% 97%, 24% 100%, 20% 97%, 16% 100%, 12% 97%, 8% 100%, 4% 97%, 0 100%);
  }
  .paper small { display: block; text-align: center; font: 11px/1.5 var(--mono); letter-spacing: .12em; }
  .paper-h { display: block; margin: 17px 0 9px; text-align: center; font: 400 28px/1.15 var(--serif); }
  .rule { display: block; margin: 18px 0 13px; border-top: 1px dashed #746965; }
  .paper dl { margin: 0; }
  .paper dl div { display: flex; justify-content: space-between; gap: 12px; padding: 4px 0; }
  .paper dt, .paper dd { margin: 0; }
  .total { display: block; margin: 7px 0 10px; text-align: center; font: 400 20px/1.3 var(--serif); }

  .thread { padding: 5px; }
  .moments { list-style: none; margin: 23px 0 0; padding: 0 0 0 21px; border-left: 1px solid #6b4651; }
  .moments li { position: relative; margin: 0 0 27px; }
  .moments li:last-child { margin-bottom: 0; }
  .moments li::before { content: ''; position: absolute; left: -25px; top: 5px; width: 7px; height: 7px; border: 1px solid #ef8ea1; border-radius: 50%; background: #25121b; }
  .m-time { display: block; font: 11px/1.5 var(--mono); color: #ef8ea1; }
  .m-title { display: block; margin: 4px 0 5px; font: 400 21px/1.2 var(--serif); color: var(--text); }
  .m-detail { display: block; font: 12px/1.6 var(--sans); color: #cbb8bd; }

  .tw-copy { margin-top: 10px; }

  @media (max-width: 600px) {
    .tw-scene { grid-template-columns: minmax(0, 1fr); gap: 25px; margin: 24px 0 0; }
    .thread { width: 100%; max-width: 300px; margin: auto; }
  }
</style>
