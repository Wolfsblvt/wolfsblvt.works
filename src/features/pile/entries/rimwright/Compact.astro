---
/**
 * Rimwright, compact: a dark workbench plate. The relationship tags (RimWorld → modding workshop) belong in the
 * object, where a visitor can understand what kind of thing Rimwright is; then the title, the selected wall and the
 * hook. The wall is original vector work, not a game texture. The host supplies the plate's tilt.
 */
import type { PileEntry } from '../../catalogue';

interface Props {
  entry: PileEntry;
}
const { entry } = Astro.props;
const { title, form } = entry.data;
const from = form.kind === 'lineage' ? form.from : 'RimWorld';
---

<div class="rw">
  <span class="rw-tags"><span class="rw-from">{from}</span><span>→ modding workshop</span></span>
  <span class="rw-name">{title}</span>
  <svg class="rw-art" viewBox="0 0 280 160" aria-hidden="true">
    <ellipse cx="140" cy="134" rx="104" ry="18" fill="#060b10" fill-opacity=".33"/>
    <path d="M45 61l80-36 114 40-79 39z" fill="#90908a"/>
    <path d="M45 61v47l115 43v-47z" fill="#5e6667"/>
    <path d="M160 104v47l79-39V65z" fill="#424e54"/>
    <g fill="none" stroke="#28353a" stroke-width="3">
      <path d="M45 85l115 43 79-40M82 75v23m39-8v24M78 99v22m41-7v22M187 90v24m27-37v24m-38 22v20m27-34v20M85 43l113 41M164 39l-78 37"/>
    </g>
    <path d="M37 58l88-40 122 44v56l-87 42-123-46z" fill="none" stroke="#f2b35f" stroke-width="1.5" stroke-dasharray="4 5"/>
  </svg>
  <span class="rw-hook">Start with a thing you want to change.</span>
</div>

<style>
  .rw { padding: 23px 17px 20px; border-radius: 10px; border: 1px solid #596066; background: linear-gradient(125deg, #262c30, #14191e); color: var(--text); font-family: var(--sans); }
  .rw-tags { display: flex; flex-wrap: wrap; align-items: center; gap: 9px; font: 12px/1.4 var(--mono); color: #b8c4c9; }
  .rw-from { padding: 4px 8px; border: 1px solid #647175; border-radius: 3px; }
  .rw-name { display: block; margin-top: 12px; font: 750 22px/1.15 var(--sans); }
  .rw-art { display: block; width: 100%; height: 88px; margin: 8px 0; }
  .rw-hook { display: block; margin-top: 8px; font-size: 14px; line-height: 1.45; }
</style>
