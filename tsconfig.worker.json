{
  // The Worker, the contact service, the shared contract and every test, typed for the Workers runtime.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types", "node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true
  },
  "include": ["worker/**/*", "shared/**/*", "tests/**/*", "vitest.config.ts", "src/lib/shape.ts", "src/lib/walk.ts", "src/lib/mark-ease.ts", "src/features/pile/client/selection.ts"],
  "exclude": ["node_modules", "tests/e2e/**"]
}