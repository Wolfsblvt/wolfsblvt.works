{
  // Test-only Worker configuration for the contact seam. The production bindings belong to the later Works
  // composition; this file declares no routes, domains or account and is never deployed.
  "name": "wolfsblvt-contact-test",
  "main": "./contact-worker.ts",
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": "./contact-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ENVIRONMENT_NAME": "test",
    "BUILD_VERSION": "test-build",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "CONTACT_INBOX": "contact@wolfsblvt.works",
    "CONTACT_SENDING_ENABLED": "true"
  },
  "send_email": [
    { "name": "CONTACT_INTERNAL", "destination_address": "contact@wolfsblvt.works" },
    { "name": "CONTACT_VISITOR_COPY", "allowed_sender_addresses": ["contact@wolfsblvt.works"] }
  ],
  "ratelimits": [
    { "name": "RATE_IP", "namespace_id": "9001", "simple": { "limit": 100, "period": 60 } },
    { "name": "RATE_RECIPIENT", "namespace_id": "9002", "simple": { "limit": 100, "period": 60 } },
    { "name": "RATE_LOCATION", "namespace_id": "9003", "simple": { "limit": 100, "period": 60 } }
  ]
}
